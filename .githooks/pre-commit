#!/usr/bin/env bash
# Блокирует коммит при красных функциональных тестах.
# Активация (один раз после клона): git config core.hooksPath .githooks
# Обход (на свой риск): git commit --no-verify
changed=$(git diff --cached --name-only)
if echo "$changed" | grep -qE '^(app\.js|telegram-notify\.js|tests/)'; then
  echo "▶ Регрессионные тесты (tests/run.sh)…"
  if ! bash tests/run.sh >/tmp/precommit-tests.log 2>&1; then
    echo "❌ Тесты упали — коммит заблокирован:"
    tail -40 /tmp/precommit-tests.log
    echo "Обойти (не рекомендуется): git commit --no-verify"
    exit 1
  fi
  echo "✅ Тесты зелёные"
fi

# Авто-версионирование ассетов: ?v=<hash8> по содержимому каждого локального файла,
# на который ссылается index.html (app*.js, styles.css, data.js…). Убирает ручной бамп
# ?v= и устаревший кэш у пользователей. Идемпотентно: при неизменном содержимом — no-op.
if [ -f index.html ]; then
  changedidx=0
  for asset in $(grep -oE '[A-Za-z0-9_./-]+\?v=[0-9a-z]+' index.html | sed 's/?v=.*//' | sort -u); do
    [ -f "$asset" ] || continue
    h=$(shasum -a1 "$asset" | cut -c1-8)
    A="$asset" H="$h" perl -0pi -e 's/(\Q$ENV{A}\E\?v=)[0-9a-z]+/$1$ENV{H}/g' index.html && changedidx=1
  done
  if [ "$changedidx" = 1 ] && ! git diff --quiet -- index.html; then
    git add index.html
    echo "🔖 Версии ассетов обновлены по хэшу (index.html перештампован)"
  fi
fi
exit 0
